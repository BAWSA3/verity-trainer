# Verity Trainer environment variables.
#
# Copy this file to .env.local and fill in the values. The .env.local file
# is gitignored so credentials never get committed.
#
# Most of these can be reused from BrandOS's .env.local
# (C:\Users\bawsa\Vibe Coding Tests\.env.local) since both projects share
# the same Supabase project + Anthropic account.

# === Reuse from BrandOS .env.local ===

# Claude Sonnet 4.6 — used by /api/generate-trainer for AI-driven trainer
# generation (system prompt + vision on the profile avatar). Without this,
# the API falls back to deterministic mock generation keyed by handle hash.
ANTHROPIC_API_KEY=

# Supabase — same project as BrandOS. Used by the signup pipeline to persist
# trainers to the trainer_signups table. Without these, /api/signup will
# 503 at request time (everything else still works).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === Verity Trainer specific — set up separately ===

# socialdata.tools — pay-per-use X profile + tweets fetcher.
# Without this, /api/generate-trainer returns mock profile data keyed by
# handle hash (4 archetype templates). Real X data only when this is set.
# Get one at https://socialdata.tools (free tier available, then $0.20/1000 fetches).
SOCIALDATA_API_KEY=

# App URL — used by the OG route to build absolute image URLs. Leave as the
# localhost value for dev; set to https://trainer.verity.gg in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Optional ===

# OpenAI — used ONLY by the moderation pipeline (omni-moderation-latest)
# for trainer name + personality chips. The static blocklist + brand-blocklist
# layers run regardless. Without this, moderation falls through to the static
# layers only.
OPENAI_API_KEY=
